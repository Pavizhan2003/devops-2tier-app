pipeline {
    agent any

    environment {
        IMAGE_NAME = 'devops-2tier-app'
        IMAGE_TAG  = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Security Scan: Dependencies') {
            steps {
                sh '''
                    echo "Scanning project source files and dependencies..."
                    trivy fs --severity HIGH,CRITICAL --exit-code 0 .
                '''
            }
        }

        stage('Install & Test') {
            agent {
                docker {
                    image 'node:20-alpine'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    npm ci
                    node test.js
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                    docker build -t ${IMAGE_NAME}:latest .
                '''
            }
        }

        stage('Security Scan: Docker Image') {
            steps {
                sh '''
                    echo "Scanning built Docker image for CVEs..."
                    trivy image --severity CRITICAL --exit-code 0 ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Verify Image') {
            steps {
                sh '''
                    docker image inspect ${IMAGE_NAME}:${IMAGE_TAG} --format='Image ID: {{.Id}}'
                '''
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "Pipeline passed: Build #${env.BUILD_NUMBER} built, tested, and scanned successfully."
        }
        failure {
            echo "Pipeline run failed. Inspect stage console output."
        }
    }
}